.ipynb_checkpoints/

# --- Project data (synthetic only, never commit) ---
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# --- Secrets / env ---
.env
*.env
!.env.example

# --- MLflow ---
mlruns/
mlartifacts/

# --- BentoML ---
bentoml/

# --- Model / report artifacts (regenerable via `make train`) ---
