# source package src/clinops/models/ stays tracked.
/models/
/reports/

# --- Synthea jar (downloaded dependency, large) ---
*.jar

# --- Stray build / run logs ---
*.log

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
