# Copy to .env and fill in. .env is git-ignored. No real secrets in this file.

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=clinops

# --- Postgres (MLflow backend store) ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MinIO (MLflow artifact store, S3-compatible) ---
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts

# --- Data paths / ETL settings (read by clinops.config.Settings) ---
DATA_RAW=data/raw
DATA_INTERIM=data/interim
DATA_PROCESSED=data/processed
TARGET_NAME=readmission_30d
RANDOM_SEED=42
REFERENCE_DATE=2024-01-01

# --- Model promotion thresholds (used by the registry, not yet wired) ---
PROMOTION_METRIC=roc_auc
PROMOTION_MIN_IMPROVEMENT=0.0
